# 실제 설정 파일은 이 저장소 밖에 0600 권한으로 보관합니다.
STAGING_BACKEND_SHA=
# URL에 그대로 사용하므로 비밀번호 관리자로 생성한 48자 이상의 영숫자 사용.
STAGING_DB_PASSWORD=
STAGING_JWT_SECRET_KEY=
STAGING_ENCRYPTION_KEY=
STAGING_TS_AUTHKEY=

# Compose가 고정하는 값입니다. 위 비밀값과 별도로 여기에 변경할 값은 없습니다.
BINANCE_TESTNET=true
DRY_RUN=true
ENABLE_LIVE_TRADING=false
