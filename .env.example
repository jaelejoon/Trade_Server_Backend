JWT_SECRET_KEY=change-this-jwt-secret
ENCRYPTION_KEY=PUT_FERNET_KEY_HERE
DATABASE_URL=sqlite:///./app.db
ENVIRONMENT=dev
DISABLE_DOCS=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120

BINANCE_TESTNET=true
BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com
BINANCE_SPOT_BASE_URL=https://api.binance.com
DRY_RUN=true

CANDLE_WARMUP_DAYS=60
MIN_STRATEGY_1M_CANDLES=43200
STRATEGY_LOAD_1M_LIMIT=120000
BOT_INTERVAL_SECONDS=60
EXCLUDE_INCOMPLETE_1M_CANDLE=true
CANDLE_GAP_REFILL_LOOKBACK_HOURS=24
SERVER_TIME_DRIFT_LIMIT_MS=1000

BINANCE_REQUEST_TIMEOUT_SECONDS=10
BINANCE_MAX_RETRIES=3
BINANCE_RETRY_BASE_SLEEP_SECONDS=0.5
AUTO_CLOSE_ON_BRACKET_FAILURE=true
