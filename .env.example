# ============================================================
# 기본 서버 설정
# ============================================================

# JWT 서명 키
# 반드시 긴 랜덤 문자열 사용
# 예시 생성:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Binance API Secret 암호화용 Fernet Key
# 아래 명령으로 생성:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=PUT_FERNET_KEY_HERE

# 데이터베이스 주소
# PostgreSQL 전용
# 로컬 Docker PostgreSQL 기본값:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trade
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trade

# 개발(dev) / 운영(prod)
ENVIRONMENT=dev

# ============================================================
# CORS / Swagger
# ============================================================

# 운영 환경에서 Swagger 비활성화 권장
# 운영에서는 true 추천
DISABLE_DOCS=false

# 허용할 프론트 주소
# 운영에서는 절대 * 사용 금지
# Cookie 인증에서는 프론트 주소와 백엔드 주소의 host를 가능하면 맞추는 것이 좋음
# 예: 프론트 localhost:5173 → 백엔드 localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://trade-server-frontend.vercel.app,https://snide-spectator-landscape.ngrok-free.dev,https://localhost

# ============================================================
# HTTPS / 프록시
# ============================================================

# 로그인 요청 HTTPS 강제 여부
# 운영에서는 true 권장
REQUIRE_HTTPS_AUTH=true

# Cloudflare / Nginx 프록시 IP 신뢰 여부
# 로컬 개발은 false 권장
TRUST_PROXY_HEADERS=false

# ============================================================
# JWT / Cookie 인증
# ============================================================

# Access Token 만료 시간(분)
# 운영은 짧게 권장 (예: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh Token 만료 기간(일)
# Access Token이 만료됐을 때 자동 재발급에 사용
# 운영은 7~30일 범위에서 선택 권장
REFRESH_TOKEN_EXPIRE_DAYS=7

# HttpOnly Access Token 쿠키 이름
AUTH_COOKIE_NAME=access_token

# HttpOnly Refresh Token 쿠키 이름
# path=/auth 로 제한되어 일반 API에는 전송되지 않음
REFRESH_COOKIE_NAME=refresh_token

# 인증 쿠키 Secure 속성
# 로컬 HTTP 개발은 false
# 운영 HTTPS는 true
AUTH_COOKIE_SECURE=false

# 인증 쿠키 SameSite 속성
# 로컬에서 프론트/백엔드를 모두 localhost로 쓰면 lax 권장
# 운영에서 프론트/백엔드 도메인이 다르면 none 권장 + AUTH_COOKIE_SECURE=true 필수
AUTH_COOKIE_SAMESITE=lax

# ============================================================
# 로그인 보안
# ============================================================

# 로그인 실패 허용 횟수
LOGIN_FAILURE_LIMIT=5

# 잠금 시간(분)
LOGIN_LOCK_MINUTES=15

# 실패 횟수 집계 시간(분)
LOGIN_FAILURE_WINDOW_MINUTES=15

# ============================================================
# Rate Limit / 요청 제한
# ============================================================

# 일반 API 요청 제한 (분당)
RATE_LIMIT_PER_MINUTE=120

# 로그인 API 제한 (분당)
AUTH_RATE_LIMIT_PER_MINUTE=10

# 쓰기 요청 제한 (POST/PUT/PATCH/DELETE)
WRITE_RATE_LIMIT_PER_MINUTE=30

# Rate limit 차단 시간(초)
RATE_LIMIT_BLOCK_SECONDS=60

# 요청 body 최대 크기
# 1048576 = 1MB
MAX_REQUEST_BODY_BYTES=1048576

# ============================================================
# Binance
# ============================================================

# 테스트넷 사용 여부
# true = 테스트넷
# false = 실계정
BINANCE_TESTNET=true

# Binance Futures 주소
BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com

# Binance Spot 주소
BINANCE_SPOT_BASE_URL=https://api.binance.com

# 실제 주문 차단
# true 권장
DRY_RUN=true

# 실제 주문을 추가로 허용하는 안전장치
# 실주문 운영 전환 전까지 false 권장
ENABLE_LIVE_TRADING=false

# ============================================================
# 캔들 / 전략
# ============================================================

# 초기 캔들 warmup 기간(일)
CANDLE_WARMUP_DAYS=60

# 전략 실행 최소 1분봉 개수
# 43200 = 약 30일
MIN_STRATEGY_1M_CANDLES=43200

# 전략 로딩 최대 캔들 개수
STRATEGY_LOAD_1M_LIMIT=120000

# 전략 실행 주기(초)
ENABLE_TRADING_SCHEDULER=false
BOT_INTERVAL_SECONDS=60

# 전략 계산 방식
# closed_candle = 마감된 캔들 기준 계산
STRATEGY_CALCULATION_MODE=closed_candle

# 전략 계산 대기시간(초)
# 캔들 마감 직후 계산 안정화용
STRATEGY_CALCULATION_GRACE_SECONDS=10

# 미완성 1분봉 제외
EXCLUDE_INCOMPLETE_1M_CANDLE=true

# 캔들 누락 자동 복구 범위(시간)
CANDLE_GAP_REFILL_LOOKBACK_HOURS=24

# 장기 1분봉 Import 최대 허용 개수
CANDLE_IMPORT_MAX_1M_CANDLES=4000000

# 장기 1분봉 Import API 요청 간 대기시간(초)
CANDLE_IMPORT_REQUEST_SLEEP_SECONDS=0.08

# 사용자당 동시에 대기/실행 가능한 백테스트 수
BACKTEST_MAX_RUNNING_PER_USER=1

# 서버 전체에서 동시에 대기/실행 가능한 백테스트 수
BACKTEST_MAX_RUNNING_GLOBAL=2

# 서버 전체에서 동시에 대기/실행 가능한 장기 캔들 적재 수
CANDLE_IMPORT_MAX_RUNNING_GLOBAL=1

# Binance 서버 시간 허용 오차(ms)
SERVER_TIME_DRIFT_LIMIT_MS=1000

# ============================================================
# Binance API 안정성
# ============================================================

# 요청 타임아웃(초)
BINANCE_REQUEST_TIMEOUT_SECONDS=10

# 재시도 횟수
BINANCE_MAX_RETRIES=3

# 재시도 대기시간
BINANCE_RETRY_BASE_SLEEP_SECONDS=0.5

# 브래킷 주문 실패 시 자동 포지션 종료
AUTO_CLOSE_ON_BRACKET_FAILURE=true

# ============================================================
# 운영 보안 권장사항
# ============================================================

# 운영(prod) 환경 권장 예시:
#
# ENVIRONMENT=prod
# DISABLE_DOCS=true
# REQUIRE_HTTPS_AUTH=true
# TRUST_PROXY_HEADERS=true
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# BINANCE_TESTNET=false
# DRY_RUN=false
#
# 반드시 HTTPS 환경에서 운영 권장:
# - Cloudflare
# - Nginx SSL
# - Reverse Proxy HTTPS
#
# 운영에서는:
# - Swagger 비활성화
# - 강력한 JWT_SECRET_KEY 사용
# - ALLOWED_ORIGINS 최소화
# - 실계정 API Key 사용 시 IP 제한 권장
